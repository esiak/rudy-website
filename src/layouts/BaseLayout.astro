---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { Locale, PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  pageKey?: PageKey;
  fullWidth?: boolean;
}

const { locale, title, description, pageKey, fullWidth = false } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <a class="skip-link" href="#content">
      {t(locale, 'a11y.skip')}
    </a>
    <Header locale={locale} pageKey={pageKey} />
    <main id="content" class:list={{ container: !fullWidth, full: fullWidth }}>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .skip-link {
    background: var(--color-surface);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .skip-link:focus {
    clip-path: none;
    height: auto;
    left: var(--space-2);
    padding: var(--space-2) var(--space-3);
    top: var(--space-2);
    width: auto;
    z-index: 10;
  }

  main {
    min-height: 60vh;
    padding-block: var(--space-5);
  }

  main.full {
    padding-block: 0;
  }
</style>
