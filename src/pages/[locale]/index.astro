---
import HomeButton from '../../components/home/HomeButton.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import HomeReferences from '../../components/home/HomeReferences.astro';
import HomeSection from '../../components/home/HomeSection.astro';
import HomeServices from '../../components/home/HomeServices.astro';
import HomeTestimonials from '../../components/home/HomeTestimonials.astro';
import { home } from '../../i18n/home';
import { getLocalizedPath, locales } from '../../i18n/routes';
import type { Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import closingPhoto from '../../assets/24220_036-Hintergrund-freigestellt-H600.jpg';
import examplePhoto from '../../assets/24220_012-H600.jpg';
import { Image } from 'astro:assets';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = home[locale];
const contactPath = getLocalizedPath('contact', locale);
---

<BaseLayout
  locale={locale}
  pageKey="home"
  title={`${t(locale, 'nav.home')} | Dr. Rudy Pastel`}
  description={copy.description}
  fullWidth
>
  <HomeHero locale={locale} />
  <HomeSection
    variant="white"
    id="partner"
    heading={copy.partnerHeading}
    class="home-partner"
  >
    <h2 id="partner-heading" class="section-title">
      {copy.partnerHeading}
    </h2>
    <div class="section-intro">
      <p>{copy.partnerText}</p>
    </div>
    <div class="divider"></div>
  </HomeSection>
  <HomeReferences locale={locale} />
  <HomeSection
    variant="white"
    id="example"
    heading={copy.exampleHeading}
    class="home-example"
  >
    <h2 id="example-heading" class="section-title">
      {copy.exampleHeading}
    </h2>
    <div class="example__row">
      <div class="example__col example__col--intro">
        <h3>{copy.exampleSubheading}</h3>
        <div class="example__divider"></div>
        <p>{copy.exampleText1}</p>
      </div>
      <div class="example__col example__col--task">
        <p>{copy.exampleText2}</p>
        <p class="example__task">{copy.exampleText3}</p>
        <div class="example__action">
          <HomeButton variant="accent" href={contactPath}>
            {t(locale, 'button.contactMe')}
          </HomeButton>
        </div>
      </div>
      <div class="example__frame">
        <Image
          src={examplePhoto}
          alt={copy.portraitAlt}
          widths={[331, 449]}
          sizes="331px"
          loading="lazy"
        />
      </div>
    </div>
  </HomeSection>
  <HomeServices locale={locale} />
  <HomeTestimonials locale={locale} />
  <HomeSection
    variant="photo"
    image={closingPhoto}
    id="closing"
    heading={copy.closingLine}
    class={`home-closing home-closing--${locale}`}
  >
    <h2 id="closing-heading">{copy.closingLine}</h2>
    <p>{copy.signature}</p>
    <div class="closing__action">
      <HomeButton variant="accent" href={contactPath}>
        {t(locale, 'button.contactMe')}
      </HomeButton>
    </div>
  </HomeSection>
</BaseLayout>

<style>
  :global(section.band.home-partner .band__inner) {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  :global(section.band.home-example) .section-title {
    margin-block-start: 24px;
  }
  .example__row {
    display: flex;
    margin-block-start: 20px;
  }
  .example__col {
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: center;
  }
  .example__col p {
    margin-block-end: 1.75em;
  }
  .example__col--intro {
    padding: 15px 10px;
    width: 35.7%;
  }
  .example__col--intro h3 {
    color: var(--color-navy);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }
  .example__col--intro p {
    padding-inline-end: 35px;
  }
  .example__divider {
    border-top: 2px solid var(--color-primary);
    margin-block: 2px;
    width: 15%;
  }
  .example__col--task {
    margin-inline: 2px;
    padding: 0 15px 15px 10px;
    width: 29.22%;
  }
  .example__task {
    font-style: italic;
    font-weight: 500;
  }
  .example__action {
    padding-block-start: 25px;
    text-align: center;
  }
  /* The photo overlaps a blue rounded box, as on the live site. */
  .example__frame {
    align-self: flex-start;
    background: var(--color-primary);
    border-radius: var(--radius-card);
    margin: 30px;
    padding: 30px 13px 30px 0;
    width: 29.05%;
  }
  .example__frame img {
    border-radius: var(--radius-card);
    height: auto;
    margin: -15px -15px -15px -15px;
    max-width: none;
    width: calc((100% + 30px) * 0.95);
  }

  :global(section.band.home-closing .band__inner) {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 1350px;
    padding: 32px 0;
  }
  :global(section.band.home-closing) h2 {
    color: var(--color-surface);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }
  :global(section.band.home-closing) p {
    margin-block-end: 1.75em;
  }
  .closing__action {
    margin-inline-start: 90px;
    text-align: start;
  }
  /* Only the German page has the button on the left. */
  :global(section.band.home-closing--fr) .closing__action,
  :global(section.band.home-closing--en) .closing__action {
    margin-inline-start: 0;
    padding-block-start: 25px;
    text-align: center;
  }

  @media (max-width: 921px) {
    :global(section.band.home-closing) h2 {
      font-size: 25px;
    }
  }

  @media (max-width: 1024px) {
    :global(section.band.home-partner) {
      padding-block: 60px;
    }
    :global(section.band.home-partner) .divider {
      margin-block-end: 7px;
    }
    :global(section.band.home-example) {
      padding-block: 60px;
    }
    .example__row {
      flex-wrap: wrap;
      padding-inline: 20px;
    }
    .example__col--intro {
      margin: 10px;
      padding: 0 0 5px;
      width: calc(100% - 20px);
    }
    .example__col--intro p {
      padding-inline-end: 0;
    }
    .example__col--task {
      margin: 0;
      padding: 10px;
      width: 49.6%;
    }
    .example__frame {
      margin: 30px 30px 30px 31.91px;
      width: 41.85%;
    }
    :global(section.band.home-closing .band__inner) {
      padding: 0;
    }
  }

  @media (max-width: 767px) {
    :global(section.band.home-partner) .section-intro {
      padding-inline: 22px;
    }
    .example__col--task,
    .example__frame {
      width: 100%;
    }
    :global(section.band.home-closing) p {
      padding-inline: 22px;
    }
  }
</style>
