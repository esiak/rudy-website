---
import { locales, routes } from '../../i18n/routes';
import type { Locale, PageKey } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    (Object.keys(routes) as PageKey[])
      .filter((pageKey) => pageKey !== 'home')
      .filter((pageKey) => pageKey !== 'services')
      .filter((pageKey) => pageKey !== 'about')
      .filter((pageKey) => pageKey !== 'contact')
      .map((pageKey) => ({
        params: { locale, slug: routes[pageKey][locale] || undefined },
        props: { locale, pageKey },
      })),
  );
}

interface Props {
  locale: Locale;
  pageKey: PageKey;
}

const { locale, pageKey } = Astro.props;
const label = t(locale, `nav.${pageKey}`);
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title={`${label} | Dr. Rudy Pastel`}
>
  <h1>{label}</h1>
</BaseLayout>
