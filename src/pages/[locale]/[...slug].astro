---
import { locales, routes } from '../../i18n/routes';
import type { Locale, PageKey } from '../../i18n/routes';
import { t } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    (Object.keys(routes) as PageKey[]).map((pageKey) => ({
      params: { locale, slug: routes[pageKey][locale] || undefined },
      props: { locale, pageKey },
    })),
  );
}

interface Props {
  locale: Locale;
  pageKey: PageKey;
}

const { locale, pageKey } = Astro.props;
const label = t(locale, `nav.${pageKey}`);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{label}</title>
  </head>
  <body>
    <h1>{label}</h1>
  </body>
</html>
