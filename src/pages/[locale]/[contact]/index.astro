---
import ContactForm from '../../../components/contact/ContactForm.astro';
import { locales, routes } from '../../../i18n/routes';
import type { Locale } from '../../../i18n/routes';
import { t } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale, contact: routes.contact[locale] },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale, 'nav.contact');
---

<BaseLayout
  locale={locale}
  pageKey="contact"
  title={`${label} | Dr. Rudy Pastel`}
  fullWidth
>
  <section class="page-title page-title--contact">
    <div class="page-title__inner">
      <h1>{label}</h1>
      <div class="page-title__divider"></div>
    </div>
  </section>
  <div class={`contact contact--${locale}`}>
    <div class="contact__row">
      <section class="contact__card" aria-labelledby="contact-form-title">
        <h2 id="contact-form-title">{t(locale, 'contact.formTitle')}</h2>
        <div class="contact__divider"></div>
        <ContactForm locale={locale} />
      </section>
      <aside class="contact__side">
        <h2>{t(locale, 'contact.messageMeTitle')}</h2>
        <div class="contact__divider"></div>
        <div class="contact__text">
          <p>{t(locale, 'contact.messageMeText')}</p>
          <p>
            <a href="mailto:pastel.web@rudypastel.com">
              pastel.web@rudypastel.com
            </a>
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  /* Values measured from the live Elementor page. */
  .page-title--contact {
    align-items: stretch;
  }

  .page-title--contact::before {
    background-image: url('../../../assets/24220_036-freigestellt-Kopie.png');
  }

  .contact {
    padding-block: 100px;
  }

  .contact__row {
    display: flex;
    margin: -29px auto 0;
    max-width: var(--content-width);
    padding-block-start: 50px;
  }

  .contact__card {
    border-radius: 7px;
    box-shadow: 0 0 45px 0 rgb(213 191 191 / 50%);
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-inline: 25px;
    min-width: 0;
    width: 68.75%;
  }

  .contact__card h2 {
    color: var(--color-navy);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  /* The French and English pages use a small form heading set lower, and
     the English page a large "Message me!" heading. */
  .contact--fr .contact__card h2,
  .contact--en .contact__card h2 {
    font-size: 1rem;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .contact--fr .contact__card h2,
    .contact--en .contact__card h2 {
      margin-block-start: 35px;
    }
  }

  .contact--en .contact__side h2 {
    font-size: 22px;
    line-height: 1.3;
  }

  .contact__divider {
    border-top: 2px solid var(--color-primary);
    margin-block: 2px;
    width: 9%;
  }

  .contact__side {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    padding: 25px 25px 25px 10px;
    width: 31.25%;
  }

  .contact__side h2 {
    color: var(--color-navy);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }

  .contact__text {
    color: var(--color-text);
    padding-inline-end: 55px;
  }

  .contact__text p {
    margin-block-end: 1.75em;
  }

  .contact__text a {
    text-decoration: none;
  }

  @media (max-width: 1024px) {
    .page-title--contact {
      min-height: 33.4vh;
      padding-block: 70px 50px;
    }

    .page-title--contact .page-title__inner {
      padding-block: 0;
    }

    .contact {
      padding: 70px 20px;
    }

    .contact__row {
      padding: 33px 20px 0 0;
    }

    .contact__card {
      margin: 10px;
      width: 71.25%;
    }

    .contact__side {
      margin: 10px;
      padding: 0;
      width: 28.75%;
    }

    .contact__text {
      padding-inline-end: 0;
    }
  }

  @media (max-width: 921px) {
    .contact--de .contact__card h2,
    .contact--en .contact__side h2 {
      font-size: 20px;
    }
  }

  @media (max-width: 767px) {
    .contact {
      padding-block: 70px 50px;
    }

    .contact__row {
      flex-direction: column;
      margin-block-start: 0;
      padding: 0;
    }

    .contact__card {
      margin: 5px 10px 10px;
      padding-block: 30px;
      width: auto;
    }

    .contact__card .contact__divider {
      margin-inline: auto;
    }

    .contact__side {
      margin: 0 0 19.5px;
      padding: 30px 10px 0;
      width: auto;
    }
  }
</style>
