---
import { locales, getLocalizedPath, routes } from '../../../i18n/routes';
import type { Locale } from '../../../i18n/routes';
import { t } from '../../../i18n/ui';
import { thanksSlugs } from '../../../components/contact/thanks';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: {
      locale,
      contact: routes.contact[locale],
      thanks: thanksSlugs[locale],
    },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = t(locale, 'contact.thanksTitle');
---

<BaseLayout
  locale={locale}
  pageKey="contact"
  title={`${title} | Dr. Rudy Pastel`}
>
  <h1>{title}</h1>
  <p>{t(locale, 'contact.thanksText')}</p>
  <p>
    <a href={getLocalizedPath('home', locale)}>
      {t(locale, 'contact.backHome')}
    </a>
  </p>
</BaseLayout>
