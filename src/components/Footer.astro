---
import { getLocalizedPath } from '../i18n/routes';
import type { Locale } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();

// Same link order as the live site: German lists the imprint first.
const linkKeys =
  locale === 'de'
    ? (['imprint', 'privacy'] as const)
    : (['privacy', 'imprint'] as const);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__copy">
      © {year} {t(locale, 'footer.owner')}
    </p>
    <ul class="site-footer__links">
      {linkKeys.map((key) => (
        <li>
          <a href={getLocalizedPath(key, locale)}>
            {t(locale, `footer.${key}`)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  /* Values measured from the live site's Astra footer. */
  .site-footer {
    background: var(--color-footer);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    padding-block: 20px;
  }

  /* Two equal halves, each centred: copyright left, legal links right. */
  .site-footer__inner {
    align-items: start;
    column-gap: 50px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-inline: auto;
    max-width: 1200px;
    min-height: 60px;
  }

  .site-footer__copy {
    margin: 0;
    text-align: center;
  }

  .site-footer__links {
    display: flex;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__links a {
    color: var(--color-primary);
    display: block;
    font-size: 16px;
    line-height: 1.65;
    padding-inline-end: 50px;
    text-decoration: none;
  }

  @media (max-width: 921px) {
    .site-footer__copy,
    .site-footer__links {
      margin-block-end: 10px;
    }

    .site-footer__links {
      display: grid;
    }
  }

  @media (max-width: 767px) {
    .site-footer__links a {
      font-size: 1rem;
      padding-inline: 20px;
    }
  }

  @media (max-width: 544px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
