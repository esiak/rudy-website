---
import { getLocalizedPath } from '../i18n/routes';
import type { Locale } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();

// Same link order as the live site: German lists the imprint first.
const linkKeys =
  locale === 'de'
    ? (['imprint', 'privacy'] as const)
    : (['privacy', 'imprint'] as const);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__copy">
      © {year} {t(locale, 'footer.owner')}
    </p>
    <ul class="site-footer__links">
      {linkKeys.map((key) => (
        <li>
          <a href={getLocalizedPath(key, locale)}>
            {t(locale, `footer.${key}`)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: 1rem;
    padding-block: var(--space-5);
  }

  /* Two equal halves, each centred: copyright left, legal links right. */
  .site-footer__inner {
    align-items: center;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr 1fr;
    text-align: center;
  }

  .site-footer__copy {
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__links a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 767px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
