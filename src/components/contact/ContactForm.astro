---
import { getLocalizedPath } from '../../i18n/routes';
import type { Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { getThanksPath } from './thanks';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<form
  name="contact"
  method="POST"
  action={getThanksPath(locale)}
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-name-required={t(locale, 'form.error.nameRequired')}
  data-email-required={t(locale, 'form.error.emailRequired')}
  data-email-invalid={t(locale, 'form.error.emailInvalid')}
  data-message-required={t(locale, 'form.error.messageRequired')}
>
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="language" value={locale} />
  <div class="honeypot">
    <label for="contact-bot-field">
      Do not fill this field
      <input
        id="contact-bot-field"
        name="bot-field"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </label>
  </div>
  <div class="field">
    <label for="contact-name">{t(locale, 'form.name')}</label>
    <input
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      placeholder={t(locale, 'form.name')}
      required
    />
    <p class="error" id="contact-name-error"></p>
  </div>
  <div class="field">
    <label for="contact-email">{t(locale, 'form.email')}</label>
    <input
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      placeholder={t(locale, 'form.email')}
      required
    />
    <p class="error" id="contact-email-error"></p>
  </div>
  <div class="field">
    <label for="contact-message">{t(locale, 'form.message')}</label>
    <textarea
      id="contact-message"
      name="message"
      rows="4"
      autocomplete="off"
      placeholder={t(locale, 'form.messagePlaceholder')}
      required
    ></textarea>
    <p class="error" id="contact-message-error"></p>
  </div>
  <button type="submit">{t(locale, 'form.submit')}</button>
  <p class="privacy">
    {t(locale, 'form.privacyNote')}{' '}
    <a href={getLocalizedPath('privacy', locale)}>
      {t(locale, 'form.privacyLink')}
    </a>
  </p>
</form>

<script>
  import './contact-form';
</script>

<style>
  /* Values measured from the live Elementor form. */
  .honeypot {
    display: none;
  }
  .field {
    margin-bottom: 10px;
  }
  label {
    color: var(--color-text);
    display: block;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }
  input,
  textarea {
    background: var(--color-surface);
    border: 1px solid #69727d;
    border-radius: 4px;
    color: var(--color-text);
    display: block;
    font: inherit;
    font-size: 16px;
    line-height: 24px;
    padding: 12px 16px;
    width: 100%;
  }
  input {
    height: 40px;
  }
  textarea {
    border-radius: 3px;
    font-size: 15px;
    line-height: 21px;
    padding: 5px 14px;
  }
  ::placeholder {
    color: var(--color-text);
    opacity: 1;
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: #b00020;
  }
  .error {
    color: #b00020;
    font-size: 14px;
    margin-top: 4px;
  }
  .error:empty {
    display: none;
  }
  button {
    background: var(--color-accent);
    border: 0;
    border-radius: 3px;
    color: var(--color-surface);
    cursor: pointer;
    display: block;
    font: inherit;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    padding: 15px 30px;
    width: 100%;
  }
  .privacy {
    color: var(--color-text);
    font-size: 14px;
    margin-top: 10px;
  }
</style>
