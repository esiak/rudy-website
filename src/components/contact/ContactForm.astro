---
import { getLocalizedPath } from '../../i18n/routes';
import type { Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { getThanksPath } from './thanks';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<form
  name="contact"
  method="POST"
  action={getThanksPath(locale)}
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-name-required={t(locale, 'form.error.nameRequired')}
  data-email-required={t(locale, 'form.error.emailRequired')}
  data-email-invalid={t(locale, 'form.error.emailInvalid')}
  data-message-required={t(locale, 'form.error.messageRequired')}
>
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="language" value={locale} />
  <div class="honeypot">
    <label for="contact-bot-field">
      Do not fill this field
      <input
        id="contact-bot-field"
        name="bot-field"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </label>
  </div>
  <div class="field">
    <label for="contact-name">{t(locale, 'form.name')}</label>
    <input
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      required
    />
    <p class="error" id="contact-name-error"></p>
  </div>
  <div class="field">
    <label for="contact-email">{t(locale, 'form.email')}</label>
    <input
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      required
    />
    <p class="error" id="contact-email-error"></p>
  </div>
  <div class="field">
    <label for="contact-message">{t(locale, 'form.message')}</label>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      autocomplete="off"
      required
    ></textarea>
    <p class="error" id="contact-message-error"></p>
  </div>
  <button type="submit">{t(locale, 'form.submit')}</button>
  <p class="privacy">
    {t(locale, 'form.privacyNote')}
    <a href={getLocalizedPath('privacy', locale)}>
      {t(locale, 'form.privacyLink')}
    </a>
  </p>
</form>

<script>
  import './contact-form';
</script>

<style>
  .honeypot {
    display: none;
  }

  .field {
    margin-bottom: var(--space-3);
  }

  label {
    display: block;
    margin-bottom: var(--space-1);
  }

  input,
  textarea {
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius);
    color: inherit;
    display: block;
    font: inherit;
    padding: var(--space-2) var(--space-3);
    width: 100%;
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: #b00020;
  }

  .error {
    color: #b00020;
    margin-top: var(--space-1);
  }

  .error:empty {
    display: none;
  }

  button {
    background: var(--color-primary);
    border: 0;
    border-radius: var(--radius);
    color: var(--color-surface);
    cursor: pointer;
    font: inherit;
    padding: var(--space-2) var(--space-4);
  }

  .privacy {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-top: var(--space-3);
  }
</style>
