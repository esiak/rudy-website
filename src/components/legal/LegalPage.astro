---
import type { Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImprintDe from './content/de/imprint.md';
import ImprintFr from './content/fr/imprint.md';
import ImprintEn from './content/en/imprint.md';
import PrivacyDe from './content/de/privacy.md';
import PrivacyFr from './content/fr/privacy.md';
import PrivacyEn from './content/en/privacy.md';

interface Props {
  locale: Locale;
  pageKey: 'imprint' | 'privacy';
}

const { locale, pageKey } = Astro.props;
const label = t(locale, `nav.${pageKey}`);
const content = {
  imprint: { de: ImprintDe, fr: ImprintFr, en: ImprintEn },
  privacy: { de: PrivacyDe, fr: PrivacyFr, en: PrivacyEn },
};
const Content = content[pageKey][locale];
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title={`${label} | Dr. Rudy Pastel`}
  fullWidth
>
  <article class="legal">
    <h1>{label}</h1>
    <div class="legal__content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  /* Values measured from the live site's plain Astra pages. */
  .legal {
    margin-inline: auto;
    max-width: 1240px;
    overflow-wrap: anywhere;
    padding: 60px 20px;
  }
  .legal h1 {
    color: var(--color-header);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 calc(0.6em + 4.4px);
  }
  .legal :global(h2),
  .legal :global(h3),
  .legal :global(h4) {
    color: var(--color-header);
    font-weight: 600;
    margin: 0 0 20px;
  }
  .legal :global(h2) {
    font-size: 30px;
    line-height: 1.3;
  }
  .legal :global(h3) {
    font-size: 22px;
    line-height: 1.3;
  }
  .legal :global(h4) {
    font-size: 1.25rem;
    line-height: 1.2;
  }
  .legal :global(p) {
    margin-block-end: 1.6em;
  }
  .legal :global(ul) {
    list-style: disc;
    margin: 1em 0;
    padding-inline-start: 20px;
  }
  /* The live pages show addresses as plain text. */
  .legal :global(a) {
    color: inherit;
    text-decoration: none;
  }
  .legal :global(a:hover) {
    text-decoration: underline;
  }

  @media (max-width: 921px) {
    .legal {
      padding-block: 0;
    }
    .legal :global(h2) {
      font-size: 25px;
    }
    .legal :global(h3) {
      font-size: 20px;
    }
  }
</style>
