---
import { Image } from 'astro:assets';
import { home } from '../../i18n/home';
import type { Locale } from '../../i18n/routes';
import { getTestimonials } from '../../lib/content';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
  /** The About page shows the same block with its own spacing and copy. */
  variant?: 'home' | 'about';
  heading?: string;
  intro?: string;
}

const { locale, variant = 'home' } = Astro.props;
const heading = Astro.props.heading ?? home[locale].testimonialsHeading;
const intro = Astro.props.intro ?? home[locale].testimonialsIntro;
const testimonials = await getTestimonials(locale);
---

<HomeSection
  variant="grey"
  id="testimonials"
  heading={heading}
  class:list={[
    'home-testimonials',
    variant === 'home'
      ? `home-testimonials--${locale}`
      : ['about-testimonials', `about-testimonials--${locale}`],
  ]}
>
  <div class="testimonials__column">
    <h2 id="testimonials-heading" class="section-title">
      {heading}
    </h2>
    <div class="section-intro">
      <p>{intro}</p>
    </div>
    <div class="divider"></div>
    {testimonials.map((testimonial) => (
      <figure class="card testimonial">
        <svg
          class="testimonial__icon"
          aria-hidden="true"
          viewBox="0 0 512 512"
          width="19"
          height="19"
        >
          <path d="M464 256h-80v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8c-88.4 0-160 71.6-160 160v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48zm-288 0H96v-64c0-35.3 28.7-64 64-64h8c13.3 0 24-10.7 24-24V56c0-13.3-10.7-24-24-24h-8C71.6 32 0 103.6 0 192v240c0 26.5 21.5 48 48 48h128c26.5 0 48-21.5 48-48V304c0-26.5-21.5-48-48-48z" />
        </svg>
        <Image
          src={testimonial.photo}
          alt={testimonial.authorName}
          width={209}
          height={209}
          densities={[1, 1.6]}
          loading="lazy"
        />
        <blockquote>
          <p>{testimonial.quote}</p>
        </blockquote>
        <div class="divider"></div>
        <figcaption>
          {testimonial.authorName} ({testimonial.authorRole})
        </figcaption>
      </figure>
    ))}
  </div>
</HomeSection>

<style>
  :global(section.band.home-testimonials) {
    padding-block: 75px;
  }
  /* The live column is slightly narrower than the page and not centred. */
  .testimonials__column {
    width: 93.519%;
  }
  :global(section.band.home-testimonials) .section-title {
    padding-block-end: 20px;
  }
  .testimonials__column {
    display: flex;
    flex-direction: column;
  }
  .testimonials__column > .divider {
    margin-block-end: 57px;
  }
  .testimonial {
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0 25px;
    padding: 10px;
    text-align: center;
  }
  .testimonial__icon {
    box-sizing: content-box;
    fill: var(--color-primary);
    margin-inline: auto;
    padding-block: 25px 8px;
  }
  .testimonial img {
    border: 3px solid var(--color-primary);
    border-radius: 50px;
    height: auto;
    margin-inline: auto;
    width: 21%;
  }
  .testimonial blockquote {
    padding-inline: 25px;
  }
  .testimonial blockquote p {
    margin-block-end: 1.75em;
  }
  .testimonial figcaption {
    color: var(--color-navy);
    padding-block-end: 25px;
  }

  /* The French and English home pages space this block differently. */
  :global(section.band.home-testimonials--fr) {
    padding-block: 75px 79px;
  }
  :global(section.band.home-testimonials--en) {
    padding-block: 150px;
  }
  :global(section.band.home-testimonials--en) .testimonials__column > .divider {
    margin-block-end: 22px;
  }
  :global(section.band.home-testimonials--en) .testimonial {
    margin: 50px 25px;
  }
  :global(section.band.home-testimonials--fr) .section-intro,
  :global(section.band.home-testimonials--en) .section-intro {
    padding-block-end: 20px;
  }
  :global(section.band.about-testimonials) {
    padding-block: 100px;
  }
  :global(section.band.about-testimonials) .section-intro {
    padding-block-end: 20px;
  }
  /* The French and English About pages use the full width. */
  :global(section.band.about-testimonials--fr) .testimonials__column,
  :global(section.band.about-testimonials--en) .testimonials__column {
    width: 100%;
  }
  :global(section.band.about-testimonials--en)
    .testimonials__column
    > .divider {
    margin-block-end: 92px;
  }
  @media (min-width: 1025px) {
    :global(section.band.about-testimonials--en) .testimonial {
      margin-block-end: 50px;
    }
  }

  @media (max-width: 1024px) {
    :global(section.band.home-testimonials) {
      padding: 170px 40px 140px;
    }
    .testimonial {
      margin: 10px;
    }
    .testimonial blockquote {
      padding-inline: 0;
    }
    :global(section.band.home-testimonials) .section-intro {
      padding-block-end: 19.5px;
    }
  }

  @media (max-width: 767px) {
    :global(section.band.home-testimonials) {
      padding-block-start: 171px;
    }
    .testimonials__column {
      width: 100%;
    }
    :global(section.band.home-testimonials) .section-intro {
      padding-inline: 22px;
    }
    .testimonial img {
      margin-block-end: 19px;
    }
  }
  @media (max-width: 1024px) {
    :global(section.band.about-testimonials) {
      padding: 70px 20px;
    }
    :global(section.band.home-testimonials--en) .testimonial {
      margin: 10px;
    }
  }
  @media (max-width: 767px) {
    :global(section.band.about-testimonials) {
      padding-block-start: 71px;
    }
    :global(section.band.about-testimonials) .testimonial img {
      margin-block-end: 11px;
    }
    :global(section.band.home-testimonials--en)
      .testimonials__column
      > .divider {
      margin-block-end: 57px;
    }
  }
</style>
