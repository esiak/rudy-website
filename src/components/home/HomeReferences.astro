---
import { home } from '../../i18n/home';
import type { Locale } from '../../i18n/routes';
import { getReferences } from '../../lib/content';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = home[locale];
const references = await getReferences(locale);
---

<HomeSection variant="grey" id="references" heading={copy.referencesHeading}>
  <h2 id="references-heading">{copy.referencesHeading}</h2>
  <p>{copy.referencesIntro}</p>
  <ul class="cards">
    {references.map((reference) => (
      <li class="card" data-card="reference">
        <h3>{reference.client}</h3>
        <p class="card__period">{reference.period}</p>
        <p>{reference.description}</p>
      </li>
    ))}
  </ul>
</HomeSection>

<style>
  .cards {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    list-style: none;
    margin-block-start: var(--space-4);
    padding: 0;
  }
  .card {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: var(--space-4);
  }
  .card__period {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-block-end: var(--space-2);
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
