---
interface Props {
  href: string;
  variant: 'accent' | 'navy';
}

const { href, variant } = Astro.props;
---

<a class={`button button--${variant}`} href={href}>
  <slot />
</a>

<style>
  /* Same as the live site's buttons, including white text on yellow. */
  .button {
    border-radius: 3px;
    color: var(--color-surface);
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    padding: 15px 30px;
    text-align: center;
    text-decoration: none;
  }
  @media (max-width: 921px) {
    .button {
      padding: 14px 28px;
    }
  }
  @media (max-width: 544px) {
    .button {
      padding: 12px 24px;
    }
  }
  .button--accent {
    background: var(--color-accent);
  }
  .button--navy {
    background: var(--color-navy);
  }
</style>
