---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  variant: 'primary' | 'white' | 'grey' | 'photo';
  id: string;
  heading?: string;
  /** Background photo for the `photo` variant. Decorative, so it has no alt text. */
  image?: ImageMetadata;
  class?: string;
}

const { variant, id, heading, image, class: className } = Astro.props;
---

<section
  class:list={['band', `band--${variant}`, className]}
  data-section={id}
  aria-labelledby={heading ? `${id}-heading` : undefined}
>
  {variant === 'photo' && image && (
    <Image
      class="band__photo"
      src={image}
      alt=""
      widths={[480, 840]}
      sizes="100vw"
      loading="lazy"
    />
  )}
  <div class="band__inner">
    <slot />
  </div>
</section>

<style>
  .band {
    padding-block: 50px;
  }
  /* Flex, like Elementor's containers, so margins never collapse. */
  .band__inner {
    display: flex;
    flex-direction: column;
    margin-inline: auto;
    max-width: var(--content-width);
  }
  .band--primary {
    background: var(--color-primary);
    color: var(--color-surface);
  }
  .band--primary :global(:focus-visible) {
    outline-color: var(--color-surface);
  }
  .band--white {
    background: var(--color-surface);
  }
  .band--grey {
    background: var(--color-surface-alt);
  }

  /* A photo behind the content with a dark overlay, like the live site's
     closing section. The photo is an <img> (not a CSS background) so the
     strict CSP needs no inline style. */
  .band--photo {
    align-items: center;
    background: var(--color-photo-overlay-base);
    color: var(--color-surface);
    display: flex;
    /* Same height as the live site's section: 49% of the window on tablets
       and phones, 60.39% on wider screens (see the media query below). */
    min-height: 49vh;
    padding-block: 40px;
    overflow: hidden;
    position: relative;
    text-align: center;
  }
  @media (min-width: 1025px) {
    .band--photo {
      min-height: 60.39vh;
      padding-block: 0;
    }
  }
  .band--photo::before {
    background: var(--color-photo-overlay);
    content: '';
    inset: 0;
    position: absolute;
    z-index: 1;
  }
  .band__photo {
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: 50% 0;
    position: absolute;
    width: 100%;
  }
  .band--photo .band__inner {
    position: relative;
    width: 100%;
    z-index: 2;
  }
  .band--photo :global(:focus-visible) {
    outline-color: var(--color-surface);
  }
</style>
