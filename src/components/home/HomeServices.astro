---
import { Image } from 'astro:assets';
import { home } from '../../i18n/home';
import type { Locale } from '../../i18n/routes';
import { getServices } from '../../lib/content';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = home[locale];
const services = await getServices(locale);
---

<HomeSection variant="primary" id="services" heading={copy.servicesHeading}>
  <h2 id="services-heading">{copy.servicesHeading}</h2>
  <p>{copy.servicesIntro}</p>
  <ul class="cards">
    {services.map((service) => (
      <li class="card" data-card="service">
        <Image
          src={service.icon}
          alt=""
          width={64}
          height={64}
          loading="lazy"
        />
        <h3>{service.title}</h3>
        <p>{service.text}</p>
      </li>
    ))}
  </ul>
</HomeSection>

<style>
  .cards {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    list-style: none;
    margin-block-start: var(--space-4);
    padding: 0;
  }
  .card {
    background: var(--color-surface);
    border-radius: var(--radius);
    color: var(--color-header);
    padding: var(--space-4);
  }
  .card img {
    height: 64px;
    margin-block-end: var(--space-3);
    width: 64px;
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
