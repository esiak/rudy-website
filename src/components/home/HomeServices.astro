---
import { Image } from 'astro:assets';
import { home } from '../../i18n/home';
import type { Locale } from '../../i18n/routes';
import { getServices } from '../../lib/content';
import HomeSection from './HomeSection.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = home[locale];
const services = await getServices(locale);
---

<HomeSection
  variant="primary"
  id="services"
  heading={copy.servicesHeading}
  class={`home-services home-services--${locale}`}
>
  <h2 id="services-heading" class="section-title">
    {copy.servicesHeading}
  </h2>
  <div class="section-intro">
    <p>{copy.servicesIntro}</p>
  </div>
  <div class="divider"></div>
  <ul class="cards">
    {services.map((service) => (
      <li class="card service" data-card="service">
        <Image
          src={service.icon}
          alt=""
          width={68}
          height={68}
          densities={[1, 2]}
          loading="lazy"
        />
        <h3>{service.title}</h3>
        <p>{service.text}</p>
      </li>
    ))}
  </ul>
</HomeSection>

<style>
  :global(section.band.home-services) .section-title,
  :global(section.band.home-services) .section-intro {
    color: var(--color-surface);
  }
  :global(section.band.home-services) .section-title {
    padding-block-end: 20px;
  }
  :global(section.band.home-services) .section-intro p {
    margin-block-end: 1.75em;
  }
  :global(section.band.home-services) .divider {
    margin-block-end: 22px;
  }
  /* The French and English pages leave more space under the intro. */
  :global(section.band.home-services--fr) .section-intro,
  :global(section.band.home-services--en) .section-intro {
    padding-block-end: 20px;
  }
  .service {
    display: flex;
    flex-direction: column;
  }
  .cards {
    display: grid;
    gap: 50px;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    margin: 50px 25px;
    padding: 0;
  }
  .service {
    padding: 10px;
    text-align: center;
  }
  .service img {
    height: auto;
    margin: 30px auto 0;
    width: 22%;
  }
  .service h3 {
    color: var(--color-navy);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 20px 0 0;
  }
  .service p {
    color: var(--color-text);
    margin: 20px 25px 1.75em;
  }

  @media (max-width: 1024px) {
    :global(section.band.home-services) {
      padding: 100px 20px;
    }
    .cards {
      gap: 20px;
      margin: 10px;
    }
    .service {
      padding: 20px;
    }
    .service img {
      margin-block-start: 0;
    }
    .service p {
      margin-inline: 0;
    }
  }

  @media (max-width: 767px) {
    :global(section.band.home-services) {
      padding: 60px 20px;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    :global(section.band.home-services) .section-intro {
      padding: 0 22px 20px;
    }
    .service h3 {
      margin-block-start: 11px;
    }
    .service p {
      margin-block-start: 0;
    }
  }
</style>
