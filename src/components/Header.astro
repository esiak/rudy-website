---
import { getAlternates, getLocalizedPath, locales } from '../i18n/routes';
import type { Locale, PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  pageKey?: PageKey;
}

const { locale, pageKey } = Astro.props;
const navKeys = ['home', 'services', 'about', 'contact'] as const;
const alternates = pageKey
  ? getAlternates(pageKey, locale)
  : getAlternates('home', locale);
---

<header class="site-header">
  <div class="site-header__bar">
    <a class="site-header__title" href={getLocalizedPath('home', locale)}>
      Dr. Rudy Pastel – Data Scientist
    </a>
    <button
      type="button"
      class="menu-button"
      aria-controls="site-nav-list"
      aria-expanded="false"
    >
      <svg
        class="menu-button__icon menu-button__icon--open"
        aria-hidden="true"
        viewBox="0 0 1000 1000"
      >
        <path d="M104 333H896C929 333 958 304 958 271S929 208 896 208H104C71 208 42 237 42 271S71 333 104 333ZM104 583H896C929 583 958 554 958 521S929 458 896 458H104C71 458 42 487 42 521S71 583 104 583ZM104 833H896C929 833 958 804 958 771S929 708 896 708H104C71 708 42 737 42 771S71 833 104 833Z" />
      </svg>
      <svg
        class="menu-button__icon menu-button__icon--close"
        aria-hidden="true"
        viewBox="0 0 1000 1000"
      >
        <path d="M742 167L500 408 258 167C246 154 233 150 217 150 196 150 179 158 167 167 154 179 150 196 150 212 150 229 154 242 171 254L408 500 167 742C138 771 138 800 167 829 196 858 225 858 254 829L496 587 738 829C750 842 767 846 783 846 800 846 817 842 829 829 842 817 846 804 846 783 846 767 842 750 829 737L588 500 833 258C863 229 863 200 833 171 804 137 775 137 742 167Z" />
      </svg>
      <span class="visually-hidden">{t(locale, 'a11y.menu')}</span>
    </button>
    <ul class="lang-switcher" aria-label={t(locale, 'a11y.language')}>
      {locales.map((code) => {
        const alt = alternates.find((a) => a.locale === code);
        return (
          <li>
            {alt ? (
              <a href={alt.path} lang={code} hreflang={code}>
                <span class="lang-switcher__code">{code.toUpperCase()}</span>
              </a>
            ) : (
              <span
                class="lang-switcher__current"
                lang={code}
                aria-current="true"
              >
                <span class="lang-switcher__code">{code.toUpperCase()}</span>
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </div>
  <nav class="site-nav" aria-label={t(locale, 'a11y.nav')}>
    <ul id="site-nav-list" class="site-nav__list">
      {navKeys.map((key) => (
        <li>
          <a
            href={getLocalizedPath(key, locale)}
            aria-current={key === pageKey ? 'page' : undefined}
          >
            {t(locale, `nav.${key}`)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const list = document.getElementById('site-nav-list');

  if (header && button && list) {
    root.classList.add('js');

    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
    };

    button.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        button.focus();
      }
    });

    // Close the menu when the visitor clicks anywhere outside the header.
    document.addEventListener('click', (event) => {
      if (isOpen() && !header.contains(event.target as Node)) {
        setOpen(false);
      }
    });
  }
</script>

<style>
  /* Values measured from the live site's Elementor header. */
  .site-header {
    background: var(--color-header);
    position: relative;
    z-index: 10;
  }

  .site-header__bar {
    align-items: center;
    display: flex;
    justify-content: space-between;
    min-height: 62px;
    padding-inline: 8%;
  }

  .site-header__bar :focus-visible {
    outline-color: var(--color-accent);
  }

  .site-header__title {
    color: var(--color-surface);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.5;
    text-decoration: none;
  }

  .site-header__title:hover {
    text-decoration: underline;
  }

  .menu-button {
    align-self: flex-start;
    background: none;
    border: 0;
    border-radius: 3px;
    cursor: pointer;
    display: none;
    fill: var(--color-surface-alt);
    padding: 11.5px;
  }

  :global(.js) .menu-button {
    display: block;
  }

  .menu-button:hover {
    fill: var(--color-accent);
  }

  .menu-button__icon {
    display: block;
    height: 46px;
    width: 46px;
  }

  .menu-button__icon--close,
  .menu-button[aria-expanded='true'] .menu-button__icon--open {
    display: none;
  }

  .menu-button[aria-expanded='true'] .menu-button__icon--close {
    display: block;
  }

  .visually-hidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .lang-switcher {
    display: flex;
    font-family: var(--font-heading);
    font-size: 14.6px;
    gap: 15px;
    line-height: normal;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lang-switcher a,
  .lang-switcher__current {
    color: var(--color-surface);
    display: inline-block;
    font-weight: 300;
    padding-inline: 7px;
    text-decoration: none;
  }

  .lang-switcher a:hover,
  .lang-switcher a:focus {
    font-weight: 600;
  }

  .lang-switcher__current {
    font-weight: 700;
  }

  .lang-switcher__code {
    padding-inline-start: 10px;
  }

  /* The menu panel: full width under the bar, light grey, large bold links. */
  .site-nav {
    background: var(--color-surface-alt);
  }

  :global(.js) .site-nav {
    left: 0;
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
  }

  :global(.js) .site-header:has(.menu-button[aria-expanded='false']) .site-nav {
    display: none;
  }

  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__list a {
    color: var(--color-text);
    display: block;
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    line-height: 20px;
    padding: 24px 32px;
    text-decoration: none;
  }

  .site-nav__list a:hover {
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .site-nav__list a[aria-current='page'] {
    background: var(--color-menu-current-bg);
    color: var(--color-accent);
  }

  .site-nav__list a:focus-visible {
    outline-offset: -3px;
  }

  @media (max-width: 1024px) {
    .site-header__bar {
      padding-inline: 5%;
    }

    .site-header__title {
      font-size: 14px;
    }
  }

  @media (max-width: 767px) {
    .site-header__bar {
      flex-direction: column;
      justify-content: center;
      min-height: 50px;
      padding-block-end: 1.5px;
    }

    .site-header__title {
      text-align: center;
    }

    .menu-button {
      padding: 5px;
    }

    .menu-button__icon {
      height: 20px;
      width: 20px;
    }

    :global(.js) .site-nav {
      top: calc(100% - 6px);
    }

    .site-nav__list a {
      padding-block: 14px;
    }
  }
</style>
