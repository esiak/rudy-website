---
import { getAlternates, getLocalizedPath, locales } from '../i18n/routes';
import type { Locale, PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  pageKey?: PageKey;
}

const { locale, pageKey } = Astro.props;
const navKeys = ['home', 'services', 'about', 'contact'] as const;
const alternates = pageKey
  ? getAlternates(pageKey, locale)
  : getAlternates('home', locale);
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__title" href={getLocalizedPath('home', locale)}>
      Dr. Rudy Pastel – Data Scientist
    </a>
    <button
      type="button"
      class="menu-button"
      aria-controls="site-nav-list"
      aria-expanded="false"
    >
      <span class="menu-button__icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
      <span class="visually-hidden">{t(locale, 'a11y.menu')}</span>
    </button>
    <ul class="lang-switcher" aria-label={t(locale, 'a11y.language')}>
      {locales.map((code) => {
        const alt = alternates.find((a) => a.locale === code);
        return (
          <li>
            {alt ? (
              <a href={alt.path} lang={code} hreflang={code}>
                {code.toUpperCase()}
              </a>
            ) : (
              <span lang={code} aria-current="true">
                {code.toUpperCase()}
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </div>
  <nav class="site-nav" aria-label={t(locale, 'a11y.nav')}>
    <ul id="site-nav-list" class="site-nav__list">
      {navKeys.map((key) => (
        <li>
          <a
            href={getLocalizedPath(key, locale)}
            aria-current={key === pageKey ? 'page' : undefined}
          >
            {t(locale, `nav.${key}`)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const list = document.getElementById('site-nav-list');

  if (header && button && list) {
    root.classList.add('js');

    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
    };

    button.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        button.focus();
      }
    });

    // Close the menu when the visitor clicks anywhere outside the header.
    document.addEventListener('click', (event) => {
      if (isOpen() && !header.contains(event.target as Node)) {
        setOpen(false);
      }
    });
  }
</script>

<style>
  .site-header {
    background: var(--color-header);
    position: relative;
    z-index: 10;
  }

  /* Title left, menu button centred, languages right, as on the live site. */
  .site-header__bar {
    align-items: center;
    column-gap: var(--space-3);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 4.3rem;
  }

  .site-header__bar :focus-visible {
    outline-color: var(--color-accent);
  }

  .site-header__title {
    color: var(--color-surface);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 300;
    justify-self: start;
    text-decoration: none;
  }

  .site-header__title:hover {
    text-decoration: underline;
  }

  .menu-button {
    background: none;
    border: 0;
    color: var(--color-surface-alt);
    cursor: pointer;
    display: none;
    height: 3rem;
    justify-content: center;
    align-items: center;
    padding: 0;
    width: 3rem;
  }

  :global(.js) .menu-button {
    display: inline-flex;
  }

  .menu-button__icon {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 30px;
  }

  .menu-button__icon span {
    background: currentColor;
    border-radius: 2px;
    display: block;
    height: 3px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  /* The three bars turn into a cross while the menu is open. */
  .menu-button[aria-expanded='true'] .menu-button__icon span:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }

  .menu-button[aria-expanded='true'] .menu-button__icon span:nth-child(2) {
    opacity: 0;
  }

  .menu-button[aria-expanded='true'] .menu-button__icon span:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-button__icon span {
      transition: none;
    }
  }

  .visually-hidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .lang-switcher {
    display: flex;
    font-family: var(--font-heading);
    gap: 0.625rem;
    justify-self: end;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lang-switcher a,
  .lang-switcher span {
    color: var(--color-surface);
    display: inline-block;
    font-weight: 400;
    padding: var(--space-2) var(--space-1);
    text-decoration: none;
  }

  .lang-switcher a:hover {
    text-decoration: underline;
  }

  .lang-switcher [aria-current='true'] {
    font-weight: 700;
  }

  /* The menu panel: full width, light grey, large bold links. */
  .site-nav {
    background: var(--color-surface-alt);
  }

  :global(.js) .site-nav {
    left: 0;
    position: absolute;
    right: 0;
    top: 100%;
  }

  :global(.js) .site-header:has(.menu-button[aria-expanded='false']) .site-nav {
    display: none;
  }

  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__list a {
    color: var(--color-menu-text);
    display: block;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    padding: 1.5rem 2rem;
    text-decoration: none;
  }

  .site-nav__list a:hover {
    color: var(--color-menu-current);
  }

  .site-nav__list a[aria-current='page'] {
    background: var(--color-menu-current-bg);
    color: var(--color-menu-current);
  }

  .site-nav__list a:focus-visible {
    outline-offset: -3px;
  }

  @media (max-width: 479px) {
    .site-header__bar {
      column-gap: var(--space-2);
    }

    .lang-switcher {
      gap: 0;
    }

    .site-nav__list a {
      font-size: 1.25rem;
      padding: 1.25rem var(--space-3);
    }
  }
</style>
