---
import { Image } from 'astro:assets';
import portrait from '../../assets/24220_024-Kopie.jpg';
import { getLocalizedPath } from '../../i18n/routes';
import type { Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import HomeButton from '../home/HomeButton.astro';
import HomeTestimonials from '../home/HomeTestimonials.astro';
import { aboutCopy } from './copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = aboutCopy[locale];
const contactPath = getLocalizedPath('contact', locale);

// "**word**" in the copy is shown in bold.
const boldParts = (text: string) =>
  text.split('**').map((part, i) => ({ text: part, bold: i % 2 === 1 }));
---

<section class="page-title page-title--about">
  <div class="page-title__inner">
    <h1>{t(locale, 'nav.about')}</h1>
    <div class="page-title__divider"></div>
  </div>
</section>

<div class="about-main">
  <div class="about-main__inner">
    <div class="about-photo">
      <div class="about-photo__image">
        <Image
          src={portrait}
          alt="Dr. Rudy Pastel – Data Scientist"
          widths={[335, 350]}
          sizes="335px"
        />
      </div>
    </div>

    <section class="about-col about-col--passion">
      <h2>{copy.passionHeading}</h2>
      <div class="about-divider"></div>
      <p class="about-text">{copy.intro}</p>
      <p class="about-talk">{copy.talk}</p>
      <p class="about-talk">
        <a href="mailto:pastel.web@rudypastel.com">pastel.web@rudypastel.com</a>
      </p>
      <div>
        <HomeButton variant="accent" href={contactPath}>
          {copy.contactLabel}
        </HomeButton>
      </div>
    </section>

    <div class="about-col about-col--bio">
      <section class="about-group">
        <h2>{copy.educationHeading}</h2>
        <div class="about-divider"></div>
        <p class="about-text">{copy.education}</p>
      </section>
      <section class="about-group">
        <h2>{copy.personalHeading}</h2>
        <div class="about-text">
          {copy.personal.map((text) => (
            <p>{text}</p>
          ))}
        </div>
        <ul class="about-social">
          <li>
            <a
              href="https://www.linkedin.com/in/rudy-pastel-de/"
              aria-label="LinkedIn"
            >
              <svg aria-hidden="true" viewBox="0 0 448 512">
                <path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.xing.com/profile/Rudy_Pastel/web_profiles?expandNeffi=true"
              aria-label="XING"
            >
              <svg aria-hidden="true" viewBox="0 0 384 512">
                <path d="M162.7 210c-1.8 3.3-25.2 44.4-70.1 123.5-4.9 8.3-10.8 12.5-17.7 12.5H9.8c-7.7 0-12.1-7.5-8.5-14.4l69-121.3c.2 0 .2-.1 0-.3l-43.9-75.6c-4.3-7.8.3-14.1 8.5-14.1H100c7.3 0 13.3 4.1 18 12.2l44.7 77.5zM382.6 46.1l-144 253v.3L330.2 466c3.9 7.1.2 14.1-8.5 14.1h-65.2c-7.6 0-13.6-4-18-12.2l-92.4-168.5c3.3-5.8 51.5-90.8 144.8-255.2 4.6-8.1 10.4-12.2 17.5-12.2h65.7c8 0 12.3 6.7 8.5 14.1z" />
              </svg>
            </a>
          </li>
        </ul>
      </section>
    </div>
  </div>
</div>

<div class="about-skills">
  <div class="about-skills__inner">
    <section class="about-skills__col">
      <h2>{copy.skillsHeading}</h2>
      <div class="about-divider"></div>
      <p class:list={['about-text', { 'about-text--plain': locale === 'de' }]}>
        {copy.skills[0]}
      </p>
      <p class="about-text">{copy.skills[1]}</p>
      <div>
        <HomeButton variant="accent" href={contactPath}>
          {copy.cvLabel}
        </HomeButton>
      </div>
    </section>
    <div class="about-skills__col">
      <section class="about-group">
        <h2>{copy.expertiseHeading}</h2>
        <div class="about-divider"></div>
        <ul class="about-checklist">
          {copy.expertise.map((item) => (
            <li>
              <svg aria-hidden="true" viewBox="0 0 512 512">
                <path d="M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
      <section class="about-group about-group--languages">
        <h2>{copy.languagesHeading}</h2>
        <div class="about-divider"></div>
        <ul class="about-languages">
          {copy.languages.map((item) => (
            <li>
              {boldParts(item).map((part) =>
                part.bold ? <strong>{part.text}</strong> : part.text,
              )}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</div>

<HomeTestimonials
  locale={locale}
  variant="about"
  heading={copy.testimonialsHeading}
  intro={copy.testimonialsLead}
/>

<section class={`about-closing about-closing--${locale}`}>
  <div class="about-closing__inner">
    <h2>{copy.closingHeading}</h2>
    <p>{copy.closing}</p>
    <div class="about-closing__divider"></div>
    <HomeButton variant="accent" href={contactPath}>
      {copy.contactLabel}
    </HomeButton>
  </div>
</section>

<style>
  /* Values measured from the live Elementor page. */
  .page-title--about::before {
    background-image: url('../../assets/24220_036-freigestellt-Kopie.png');
  }

  h2 {
    color: var(--color-navy);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .about-divider {
    border-top: 2px solid var(--color-primary);
    margin-block: 2px;
    width: 15%;
  }

  .about-text {
    color: var(--color-text);
  }

  p.about-text,
  .about-text p {
    margin-block-end: 1.75em;
  }

  p.about-text--plain {
    margin-block-end: 0;
  }

  .about-talk {
    color: var(--color-navy);
    font-weight: 600;
    line-height: 1.2;
  }

  .about-talk a {
    color: inherit;
    text-decoration: none;
  }

  .about-main {
    padding-block: 100px;
  }

  .about-main__inner,
  .about-skills__inner {
    display: flex;
    margin-inline: auto;
    max-width: var(--content-width);
  }

  /* The photo overlaps a tall blue box, as on the live site. */
  .about-photo {
    background: var(--color-primary);
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    margin: 30px 30px 97px;
    padding: 30px 13px 0 0;
    width: 29.74%;
  }

  .about-photo__image {
    margin: -25px -10px -25px -35px;
    padding: 10.5px 7px 10px 10px;
  }

  .about-photo__image img {
    height: auto;
    width: 100%;
  }

  .about-col,
  .about-group {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about-col {
    padding-inline-start: 50px;
    width: 35.13%;
  }

  .about-social {
    display: flex;
    list-style: none;
    margin: 0 -9.5px;
    padding: 0 0 67px;
  }

  .about-social li {
    margin-inline: 9.5px;
  }

  .about-social a {
    display: block;
    fill: var(--color-navy);
    padding-inline-end: 5px;
  }

  .about-social a:hover {
    fill: var(--color-primary);
  }

  .about-social svg {
    height: 22px;
    margin-inline: 2.75px;
    width: 22px;
  }

  .about-skills {
    padding-block-end: 100px;
  }

  .about-skills__col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 10px;
    width: 50%;
  }

  .about-checklist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about-checklist li {
    align-items: center;
    display: flex;
  }

  .about-checklist svg {
    fill: var(--color-navy);
    flex: none;
    height: 14px;
    margin-inline-end: 3.5px;
    width: 14px;
  }

  .about-checklist span {
    color: #5770c2;
    padding-inline-start: 5px;
  }

  .about-group--languages {
    margin-block-start: 20px;
  }

  .about-languages {
    margin: 0 0 1.5em 3em;
    padding: 0;
  }

  .about-closing {
    background: var(--color-surface)
      url('../../assets/24220_070-freigstellt-H450-links.png') no-repeat 50px 0;
    padding-block: 50px;
  }

  .about-closing__inner {
    align-items: center;
    background: rgb(255 255 255 / 87%);
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-inline: auto;
    max-width: 637px;
    text-align: center;
  }

  .about-closing p {
    color: var(--color-text);
    margin-block-end: 1.75em;
  }

  .about-closing__divider {
    border-top: 2px solid var(--color-primary);
    margin-block: 2px;
    width: 9%;
  }

  @media (min-width: 1025px) {
    .page-title--about::before {
      background-attachment: fixed;
    }
  }

  @media (max-width: 1024px) {
    .page-title--about::before {
      background-position: right center;
      opacity: 0.75;
    }

    .about-main {
      padding: 79px 20px 80px;
    }

    .about-main__inner {
      flex-wrap: wrap;
    }

    .about-photo {
      padding: 0;
      width: 41.8%;
    }

    .about-photo__image {
      margin: 10px -4px 0 -32px;
    }

    /* The live site hides the LinkedIn and Xing icons below desktop. */
    .about-social {
      display: none;
    }

    .about-col--passion {
      padding-inline-start: 20px;
      width: 49.5%;
    }

    .about-col--bio {
      margin-block-end: 20px;
      padding: 40px 0 0 20px;
      width: 100%;
    }

    .about-skills {
      padding: 0 20px 80px;
    }

    .about-closing {
      background-position: 0 0;
      padding-block: 60px;
    }
  }

  @media (max-width: 921px) {
    h2 {
      font-size: 20px;
    }
  }

  @media (max-width: 767px) {
    .page-title--about {
      min-height: 33.3vh;
      padding-block: 70px 50px;
    }

    .page-title--about::before {
      background-position: left top;
    }

    .about-main {
      padding: 60px 20px;
    }

    .about-photo {
      justify-content: space-around;
      margin: 20px 10px 20px 30px;
      width: 100%;
    }

    .about-photo__image {
      padding: 10px 10px 9px;
    }

    .about-col--passion {
      padding-inline-start: 10px;
      width: 100%;
    }

    .about-col--bio {
      padding: 30px 0 0 10px;
    }

    .about-skills__inner {
      flex-wrap: wrap;
    }

    .about-skills__col {
      width: 100%;
    }

    .about-skills__col + .about-skills__col {
      padding: 30px 10px 0;
    }

    .about-closing {
      align-items: stretch;
      display: flex;
      flex-direction: column;
      min-height: 450px;
    }

    .about-closing p {
      padding-inline: 25px;
    }

    .about-closing--fr,
    .about-closing--en {
      min-height: 0;
    }
  }
</style>
